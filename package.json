{
  "name": "remotty-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @remotty/broker --filter @remotty/web dev",
